# ============================================================
# SyncRoom environment reference
# Copy values into your host's dashboard, do NOT commit a .env.
# ============================================================

# ---- Server (runtime, set on Render / Fly / your VPS) ----

# Listen port. Render injects PORT automatically; leave unset there.
PORT=3001

# Production mode. Set this on every deployment (Render/Fly/VPS).
NODE_ENV=production

# Comma-separated origin allow-list for CORS/WebSocket handshakes.
# Exact origins and wildcard subdomains (https://*.vercel.app) are supported.
# Production example:
#   CLIENT_ORIGIN=https://syncroom.vercel.app,https://*.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# ---- Server: scalability knobs (all optional, sane defaults) ----

# Serve the built SPA from this process? Set false in split deployments where
# a CDN/static host (Vercel, Render Static, Cloudflare, Netlify) serves the
# frontend, so this box handles signaling only.
#   SERVE_CLIENT=false

# Overload protection: max concurrent WebSocket connections. New handshakes
# past this are rejected at the handshake (existing users unaffected).
#   MAX_CONNECTIONS=150

# Connection-burst smoothing (handshakes/sec admitted before staggering, and
# the max stagger delay in ms). Spreads join spikes so CPU doesn't spike.
#   CONNECTION_BURST_PER_SEC=20
#   CONNECTION_MAX_STAGGER_MS=500

# Heartbeat: ping every PING_INTERVAL_MS, drop the socket if no pong within
# PING_TIMEOUT_MS. Evicts abandoned tabs so they don't leak memory.
#   PING_INTERVAL_MS=30000
#   PING_TIMEOUT_MS=60000

# Max concurrent Google-Drive proxy streams (the one path where bytes flow
# through the server; media proper is P2P). Excess requests get a 503.
#   MAX_DRIVE_STREAMS=8

# Self-restart if RSS crosses this many MB (0 = disabled). Render free = 512 MB.
#   MEMORY_LIMIT_MB=450

# ---- Server: STUN/TURN (served to browsers at runtime via GET /ice) ----
# These are RUNTIME values: change them and restart, no client rebuild. That
# is the whole point of serving ICE from here instead of baking VITE_* vars
# into the bundle.
#
# Without a TURN relay, the ~10-15% of peer pairs behind strict/symmetric NAT
# join the room and exchange chat but NEVER exchange video (ICE finds no valid
# candidate pair). The server prints which mode it is in at boot:
#   [syncroom] TURN relay: NOT CONFIGURED — …
# There is no default relay: every usable one needs credentials, and the old
# "free public TURN" endpoints now reject every allocation.

# Public STUN, comma-separated. Defaults to Google + Cloudflare.
#   STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

# TURN endpoints, comma-separated. List UDP first and TCP/TLS on 443 last so
# peers behind port-restrictive firewalls still get a relay candidate.
# Metered (the provider HAVNN uses):
#   TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp

# Option 1 (managed providers, e.g. Metered): the static credential pair from
# the provider dashboard. NEVER commit the real values — set them in the host's
# environment (Render dashboard / EC2 service env) only.
#   TURN_USERNAME=your-username
#   TURN_CREDENTIAL=your-credential

# Option 2 (self-hosted coturn): share a secret with the relay and let /ice
# mint a short-lived username/password per request. Must equal coturn's
# `static-auth-secret` (with `use-auth-secret` in turnserver.conf). Takes
# precedence over Option 1 when set. See docs/DEPLOYMENT.md.
#   TURN_SECRET=a-long-random-string
#   TURN_TTL_SEC=86400

# ---- Client (BUILD-time, set in the Vercel dashboard) ----
# Vite inlines VITE_* variables at build time; changing them requires a
# redeploy, not a restart.

# The Socket.IO server URL (https://, the socket upgrades to wss:// itself).
# Required for split deployments; omit when the server serves the SPA.
#   VITE_SERVER_URL=https://syncroom-server.onrender.com

# TURN TEST MODE. Forces iceTransportPolicy:"relay" so every connection must
# go through the TURN relay — the definitive check that TURN works across
# networks. Currently defaults to ON in the code; set this to false (and
# rebuild) to restore normal P2P once TURN is verified. Relay-only routes 100%
# of media through the TURN provider, so it is NOT a production setting.
#   VITE_FORCE_TURN=false

# Force WebRTC candidate/state tracing on in a production build without
# enabling relay-only mode.
#   VITE_WEBRTC_DEBUG=true
